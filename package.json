{
  "name": "usba-store",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:migrate:dsql": "tsx scripts/migrate-dsql.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "e2e:prepare": "tsx --env-file-if-exists=.env scripts/e2e-prepare.ts",
    "storage:setup": "tsx --conditions=react-server --env-file-if-exists=.env scripts/setup-storage.ts",
    "admin:create": "tsx --conditions=react-server --env-file-if-exists=.env scripts/create-admin.ts",
    "setup": "pnpm infra:up && pnpm storage:setup && pnpm db:migrate && pnpm db:seed",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm build",
    "storage:cleanup": "tsx --conditions=react-server --env-file-if-exists=.env scripts/cleanup-orphans.ts",
    "brand:assets": "tsx scripts/brand-assets.ts",
    "aws:migrate": "tsx --env-file=.env.aws scripts/migrate-dsql.ts",
    "aws:seed": "tsx --conditions=react-server --env-file=.env.aws scripts/seed.ts",
    "aws:admin": "tsx --conditions=react-server --env-file=.env.aws scripts/create-admin.ts",
    "aws:build": "bash scripts/aws/build.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "@node-rs/argon2",
      "unrs-resolver",
      "esbuild"
    ],
    "overrides": {
      "source-map-js": "^1.2.2",
      "@esbuild-kit/core-utils>esbuild": "^0.25.12"
    }
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-ssm": "^3.1146.0",
    "@aws-sdk/dsql-signer": "^3.1146.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/aws": "4.1.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "5.0.3"
  }
}
