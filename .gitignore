# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# test artifacts
/playwright-report/
/test-results/
/blob-report/
/.cache/

# agent worktrees
/.claude/worktrees/

# Local scratch (screenshots etc.)
.tmp/

# OpenNext build output
/.open-next/
/dist/

# AWS CDK
/infrastructure/aws/cdk/node_modules/
/infrastructure/aws/cdk/cdk.out/
