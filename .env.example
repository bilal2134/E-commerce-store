# ---------------------------------------------------------------------------
# USBA storefront configuration. Copy to `.env` for local development.
# Every variable is validated at startup by src/server/config/env.ts.
# NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

# Public origin of the site (canonical URLs, sitemap, Open Graph, WhatsApp links).
SITE_URL=http://localhost:3000

# --- PostgreSQL ------------------------------------------------------------
# Local: docker compose (see README). Production: Supabase / Neon / RDS URL.
DATABASE_URL=postgres://usba:usba_dev_password@localhost:54329/usba
# Max connections per app instance. Keep small on serverless.
DATABASE_POOL_MAX=5
# Set to false behind transaction-mode poolers (Supabase port 6543, PgBouncer).
DATABASE_PREPARE=true
# disable | require | verify-full
DATABASE_SSL=disable
# password (default) or dsql-iam: Aurora DSQL login with an IAM token (AWS, docs/deployment/aws.md)
DATABASE_AUTH=password

# --- S3-compatible object storage (product photos, banners, review photos) --
# Local: RustFS from docker compose. Production: Supabase Storage (S3 endpoint),
# Cloudflare R2 or AWS S3 (leave S3_ENDPOINT empty for AWS).
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=usba-media
# Leave both keys empty on AWS to use the default credential chain (IAM task role).
S3_ACCESS_KEY_ID=usba_dev_access
S3_SECRET_ACCESS_KEY=usba_dev_secret_key
S3_FORCE_PATH_STYLE=true
# Key prefix for uploads, e.g. media/ when sharing a bucket (AWS). Empty locally.
S3_KEY_PREFIX=
# Public URL prefix objects are served from (public bucket or CDN domain).
MEDIA_BASE_URL=http://localhost:9100/usba-media

# AWS only (set by infrastructure/aws/cdk): CloudFront distribution to invalidate
# after admin saves (or the SSM parameter holding its ID), and the shared secret
# CloudFront sends so the Lambda URL can't be used directly. Empty locally.
CDN_DISTRIBUTION_ID=
CDN_DISTRIBUTION_ID_PARAMETER=
ORIGIN_VERIFY_SECRET=

# Request header carrying the real client IP, set by YOUR proxy/CDN only
# (cf-connecting-ip, x-real-ip, x-forwarded-for). Empty = no per-IP limits.
CLIENT_IP_HEADER=
# Proxies in front of the app that append to X-Forwarded-For. The client IP is
# read this many entries from the RIGHT, so client-sent values are ignored.
CLIENT_IP_TRUSTED_HOPS=1

# debug | info | warn | error
LOG_LEVEL=info

# Analytics seam: none | plausible
ANALYTICS_PROVIDER=none
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# First-party visitor counting (cookie-free). Secret used to derive the daily
# visitor salt. If empty, a random per-process secret is used, so unique-visitor
# counts reset whenever the server restarts (and differ between instances).
# Also keys the stored client-IP hashes used by rate limits. Set it in
# production: openssl rand -hex 32
ANALYTICS_SALT=

# Required when running more than one app instance (base64, 32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Scripts only (pnpm db:seed / pnpm admin:create) -------------------------
# Initial admin account created by `pnpm admin:create` (min 12 chars password).
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
