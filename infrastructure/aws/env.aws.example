# Production settings for the aws:* scripts and the Lambda bundle build
# (docs/deployment/aws.md). Copy to .env.aws in the repo root (git-ignored) and
# fill in the values from the CDK stack outputs.

NODE_ENV=production
# https://<your domain>, or https://<id>.cloudfront.net before the domain works
SITE_URL=https://usba.pk

# Aurora DSQL (UsbaData output DatabaseEndpoint). The aws:* scripts and the
# build connect as admin with a short-lived IAM token from your AWS CLI login.
DATABASE_URL=postgres://admin@REPLACE_ME.dsql.ap-southeast-2.on.aws:5432/postgres
DATABASE_AUTH=dsql-iam
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=2

# S3 (UsbaData output BucketName). No endpoint or keys: the AWS CLI login is used.
S3_BUCKET=REPLACE_ME
S3_REGION=ap-southeast-2
S3_KEY_PREFIX=media/
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_BASE_URL=https://usba.pk/media

# Same value as given to the CDK deploy (openssl rand -hex 32)
ANALYTICS_SALT=REPLACE_ME

# Used once by `pnpm aws:admin` to create the owner account
ADMIN_EMAIL=REPLACE_ME
ADMIN_PASSWORD=REPLACE_ME
